---
import Layout from "../layouts/Layout.astro";
import { OUTPUT_FORMATS } from "../lib/format";
import { STORAGE_KEY } from "../lib/storage";
---

<Layout>
  <div class="app">
    <header>
      <div class="brand">
        <svg
          class="brand-mark"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 100 100"
          aria-hidden="true">
          <circle cx="50" cy="50" r="38" fill="none" stroke="currentColor" stroke-width="1.5"
          ></circle>
          <circle cx="50" cy="50" r="30" fill="none" stroke="currentColor" stroke-width="2.5"
          ></circle>
          <circle cx="50" cy="50" r="22" fill="none" stroke="currentColor" stroke-width="4"
          ></circle>
          <circle cx="50" cy="50" r="10" fill="var(--accent)"></circle>
        </svg>
        <h1>HTML Reducer</h1>
      </div>
      <span class="privacy-note">your HTML never leaves your browser</span>
    </header>

    <div class="workspace">
      <!-- Controls -->
      <aside class="controls">
        <button class="controls-toggle" id="controls-toggle" aria-expanded="false">
          options
          <svg viewBox="0 0 16 16"><path d="M4 6l4 4 4-4"></path></svg>
        </button>

        <div class="controls-body collapsed" id="controls-body">
          <div class="control-section">
            <div class="section-label">strip</div>
            <div class="toggle-list">
              <label class="toggle-row">
                <span class="toggle-label"><code>scripts</code></span>
                <span class="toggle">
                  <input type="checkbox" data-key="stripScripts" checked />
                  <span class="toggle-track"></span>
                </span>
              </label>
              <label class="toggle-row">
                <span class="toggle-label"><code>styles</code></span>
                <span class="toggle">
                  <input type="checkbox" data-key="stripStyles" checked />
                  <span class="toggle-track"></span>
                </span>
              </label>
              <label class="toggle-row">
                <span class="toggle-label">comments</span>
                <span class="toggle">
                  <input type="checkbox" data-key="stripComments" checked />
                  <span class="toggle-track"></span>
                </span>
              </label>
              <label class="toggle-row">
                <span class="toggle-label"
                  ><code>meta</code> / <code>link</code> / <code>head</code></span
                >
                <span class="toggle">
                  <input type="checkbox" data-key="stripMetaLinkHead" checked />
                  <span class="toggle-track"></span>
                </span>
              </label>
              <label class="toggle-row">
                <span class="toggle-label">hidden elements</span>
                <span class="toggle">
                  <input type="checkbox" data-key="stripHidden" checked />
                  <span class="toggle-track"></span>
                </span>
              </label>
              <label class="toggle-row">
                <span class="toggle-label"><code>svg</code></span>
                <span class="toggle">
                  <input type="checkbox" data-key="stripSvg" checked />
                  <span class="toggle-track"></span>
                </span>
              </label>
              <label class="toggle-row">
                <span class="toggle-label"><code>noscript</code></span>
                <span class="toggle">
                  <input type="checkbox" data-key="stripNoscript" checked />
                  <span class="toggle-track"></span>
                </span>
              </label>
              <label class="toggle-row">
                <span class="toggle-label">event handlers</span>
                <span class="toggle">
                  <input type="checkbox" data-key="stripEventHandlers" checked />
                  <span class="toggle-track"></span>
                </span>
              </label>
            </div>
          </div>

          <div class="control-section">
            <div class="section-label">attributes</div>
            <div class="toggle-list">
              <label class="toggle-row" data-attr-sub>
                <span class="toggle-label">strip <code>id</code> / <code>class</code></span>
                <span class="toggle">
                  <input type="checkbox" data-key="stripIdClass" />
                  <span class="toggle-track"></span>
                </span>
              </label>
              <label class="toggle-row" data-attr-sub>
                <span class="toggle-label">strip <code>href</code></span>
                <span class="toggle">
                  <input type="checkbox" data-key="stripHref" />
                  <span class="toggle-track"></span>
                </span>
              </label>
              <label class="toggle-row" data-attr-sub>
                <span class="toggle-label">strip <code>src</code> / <code>alt</code></span>
                <span class="toggle">
                  <input type="checkbox" data-key="stripSrcAlt" />
                  <span class="toggle-track"></span>
                </span>
              </label>
              <label class="toggle-row">
                <span class="toggle-label">strip all attributes</span>
                <span class="toggle">
                  <input type="checkbox" data-key="stripAllAttrs" />
                  <span class="toggle-track"></span>
                </span>
              </label>
            </div>
          </div>

          <div class="control-section">
            <div class="section-label">structure</div>
            <div class="toggle-list">
              <label class="toggle-row">
                <span class="toggle-label">collapse whitespace</span>
                <span class="toggle">
                  <input type="checkbox" data-key="collapseWhitespace" checked />
                  <span class="toggle-track"></span>
                </span>
              </label>
              <label class="toggle-row">
                <span class="toggle-label">remove empty tags</span>
                <span class="toggle">
                  <input type="checkbox" data-key="removeEmptyTags" checked />
                  <span class="toggle-track"></span>
                </span>
              </label>
            </div>
          </div>

          <button class="reset-btn" id="btn-reset">reset to defaults</button>
        </div>

        <div class="attribution">
          <a
            href="https://mohamedyamani.com?utm_source=html-reducer"
            target="_blank"
            rel="noopener noreferrer">Built by Mohamed Yamani</a
          >
          <span>·</span>
          <a
            href="https://github.com/yamanidev/html-reducer"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub repository">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
              ></path>
            </svg>
          </a>
        </div>
      </aside>

      <!-- Input panel -->
      <div class="panel">
        <div class="panel-header">
          <span class="panel-title">input</span>
          <div class="panel-meta">
            <span id="input-chars">0 chars</span>
            <button class="icon-btn" id="btn-clear">
              <svg viewBox="0 0 16 16">
                <path d="M12 4L4 12M4 4l8 8"></path>
              </svg>
              clear
            </button>
          </div>
        </div>
        <textarea id="html-input" placeholder="paste html here…" spellcheck="false" autofocus
        ></textarea>
      </div>

      <!-- Output panel -->
      <div class="panel">
        <div class="panel-header panel-header--reverse">
          <div class="panel-meta">
            <span class="reduction-badge" id="reduction-badge" style="display:none">−0%</span>
            <span class="token-count">
              <span id="token-count">~0 tokens</span>
              <span class="tooltip-anchor">
                <svg viewBox="0 0 16 16">
                  <circle cx="8" cy="8" r="6"></circle>
                  <path d="M8 7.5v3M8 5v.5"></path>
                </svg>
                <span class="tooltip">estimated — 1 token ≈ 4 chars</span>
              </span>
            </span>
            <button class="icon-btn" id="btn-copy">
              <svg viewBox="0 0 16 16">
                <rect x="5" y="5" width="8" height="8" rx="1"></rect>
                <path d="M3 11V3h8"></path>
              </svg>
              copy
            </button>
          </div>
          <div class="segmented" role="group" aria-label="output format">
            <button type="button" class="segmented-option" data-format="html" aria-pressed="true"
              >html</button
            >
            <button
              type="button"
              class="segmented-option"
              data-format="markdown"
              aria-pressed="false">markdown</button
            >
            <button type="button" class="segmented-option" data-format="text" aria-pressed="false"
              >text</button
            >
          </div>
        </div>
        <div class="output-area" id="html-output"></div>
      </div>
    </div>
  </div>
</Layout>

<!--
  Hydrate persisted state before first paint to avoid a flash of default UI.
  Runs synchronously (non-module, post-DOM), so element state is correct by the time the browser paints.
-->
<script is:inline define:vars={{ STORAGE_KEY, OUTPUT_FORMATS }}>
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) {
      const stored = JSON.parse(raw);

      if (stored.format && OUTPUT_FORMATS.includes(stored.format)) {
        document.querySelectorAll("button[data-format]").forEach((btn) => {
          btn.setAttribute("aria-pressed", String(btn.dataset.format === stored.format));
        });
      }

      if (stored.reducer) {
        document.querySelectorAll("input[data-key]").forEach((input) => {
          const value = stored.reducer[input.dataset.key];
          if (typeof value === "boolean") input.checked = value;
        });

        if (stored.reducer.stripAllAttrs === true) {
          document.querySelectorAll("[data-attr-sub]").forEach((row) => {
            row.classList.add("disabled");
            const sub = row.querySelector("input");
            if (sub) sub.disabled = true;
          });
        }
      }

      if (stored.controlsOpen) {
        document.getElementById("controls-body")?.classList.remove("collapsed");
        document.getElementById("controls-toggle")?.setAttribute("aria-expanded", "true");
      }
    }
  } catch {}
</script>

<script>
  import { reduceHtml, DEFAULT_CONFIG } from "../lib/reducer";
  import type { ReducerConfiguration } from "../lib/reducer";
  import { formatOutput, OUTPUT_FORMATS } from "../lib/format";
  import type { OutputFormat } from "../lib/format";
  import { loadConfiguration, saveConfiguration } from "../lib/storage";

  const DEFAULT_FORMAT: OutputFormat = "html";

  function isValidFormat(value: unknown): value is OutputFormat {
    return typeof value === "string" && (OUTPUT_FORMATS as readonly string[]).includes(value);
  }

  const inputEl = document.getElementById("html-input") as HTMLTextAreaElement;
  const outputEl = document.getElementById("html-output") as HTMLElement;
  const inputCharsEl = document.getElementById("input-chars") as HTMLElement;
  const tokenCountEl = document.getElementById("token-count") as HTMLElement;
  const reductionEl = document.getElementById("reduction-badge") as HTMLElement;
  const clearBtn = document.getElementById("btn-clear") as HTMLButtonElement;
  const copyBtn = document.getElementById("btn-copy") as HTMLButtonElement;
  const resetBtn = document.getElementById("btn-reset") as HTMLButtonElement;
  const controlsToggle = document.getElementById("controls-toggle") as HTMLButtonElement;
  const controlsBody = document.getElementById("controls-body") as HTMLElement;
  const toggleInputs = document.querySelectorAll<HTMLInputElement>("input[data-key]");
  const stripAllInput = document.querySelector<HTMLInputElement>(
    'input[data-key="stripAllAttrs"]',
  )!;
  const attrKeepRows = document.querySelectorAll<HTMLElement>("[data-attr-sub]");
  const formatButtons = document.querySelectorAll<HTMLButtonElement>("button[data-format]");

  let storedConfiguration = loadConfiguration();
  let currentFormat: OutputFormat = isValidFormat(storedConfiguration.format)
    ? storedConfiguration.format
    : DEFAULT_FORMAT;

  function snapshotReducerConfig(): Partial<ReducerConfiguration> {
    const out: Partial<ReducerConfiguration> = {};
    toggleInputs.forEach((input) => {
      const key = input.dataset.key as keyof ReducerConfiguration;
      if (typeof DEFAULT_CONFIG[key] === "boolean") {
        (out as Record<string, boolean>)[key] = input.checked;
      }
    });

    return out;
  }

  function applyFormatButtons(): void {
    formatButtons.forEach((button) => {
      const active = button.dataset.format === currentFormat;
      button.setAttribute("aria-pressed", String(active));
    });
  }

  function debounce(fn: () => void, ms: number): () => void {
    let timer: ReturnType<typeof setTimeout>;

    return () => {
      clearTimeout(timer);
      timer = setTimeout(fn, ms);
    };
  }

  function readOptions(): ReducerConfiguration {
    const config = { ...DEFAULT_CONFIG };
    toggleInputs.forEach((input) => {
      const key = input.dataset.key as keyof ReducerConfiguration;
      if (typeof config[key] === "boolean") {
        (config as Record<string, unknown>)[key] = input.checked;
      }
    });

    return config;
  }

  function updateStats(inputLen: number, outputLen: number): void {
    inputCharsEl.textContent = `${inputLen.toLocaleString()} chars`;
    tokenCountEl.textContent = `~${Math.round(outputLen / 4).toLocaleString()} tokens`;

    const reduction = inputLen > 0 ? Math.round((1 - outputLen / inputLen) * 100) : 0;
    if (reduction > 0) {
      reductionEl.textContent = `−${reduction}%`;
      reductionEl.style.display = "";
    } else {
      reductionEl.style.display = "none";
    }
  }

  function syncStripAllAttrs(): void {
    const stripping = stripAllInput.checked;
    attrKeepRows.forEach((row) => {
      row.classList.toggle("disabled", stripping);
      const input = row.querySelector<HTMLInputElement>("input");
      if (input) input.disabled = stripping;
    });
  }

  function runProcess(): void {
    const input = inputEl.value;
    if (!input.trim()) {
      outputEl.textContent = "";
      updateStats(0, 0);
      return;
    }
    const cleaned = reduceHtml(input, readOptions());
    const output = formatOutput(cleaned, currentFormat);
    outputEl.textContent = output;
    updateStats(input.length, output.length);
  }

  const process = debounce(runProcess, 150);

  inputEl.addEventListener("input", process);

  formatButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const next = button.dataset.format;
      if (!isValidFormat(next) || next === currentFormat) return;

      currentFormat = next;
      applyFormatButtons();
      storedConfiguration = { ...storedConfiguration, format: next };
      saveConfiguration(storedConfiguration);
      runProcess();
    });
  });

  controlsToggle.addEventListener("click", () => {
    const expanded = controlsBody.classList.toggle("collapsed") === false;
    controlsToggle.setAttribute("aria-expanded", String(expanded));
    storedConfiguration = { ...storedConfiguration, controlsOpen: expanded };
    saveConfiguration(storedConfiguration);
  });

  toggleInputs.forEach((input) => {
    input.addEventListener("change", () => {
      if (input.dataset.key === "stripAllAttrs") syncStripAllAttrs();
      storedConfiguration = { ...storedConfiguration, reducer: snapshotReducerConfig() };
      saveConfiguration(storedConfiguration);
      process();
    });
  });

  clearBtn.addEventListener("click", () => {
    inputEl.value = "";
    outputEl.textContent = "";
    updateStats(0, 0);
  });

  copyBtn.addEventListener("click", async () => {
    const text = outputEl.textContent ?? "";
    if (!text) return;

    try {
      await navigator.clipboard.writeText(text);
      const original = copyBtn.innerHTML;
      copyBtn.innerHTML = "copied!";
      setTimeout(() => {
        copyBtn.innerHTML = original;
      }, 1500);
    } catch {
      // Clipboard unavailable (non-secure context)
    }
  });

  resetBtn.addEventListener("click", () => {
    toggleInputs.forEach((input) => {
      const key = input.dataset.key as keyof ReducerConfiguration;
      if (typeof DEFAULT_CONFIG[key] === "boolean") {
        input.checked = DEFAULT_CONFIG[key] as boolean;
        input.disabled = false;
      }
    });
    syncStripAllAttrs();
    storedConfiguration = { ...storedConfiguration, reducer: undefined };
    saveConfiguration(storedConfiguration);
    process();
  });

  syncStripAllAttrs();
  updateStats(0, 0);
</script>
